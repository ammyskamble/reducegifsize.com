---
// src/components/Header.astro
---

<header class="sticky top-0 z-50 border-b border-border bg-card/80 backdrop-blur-xl transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-primary/40 rounded-xl p-1">
      <img
        src="/logo.svg"
        alt="Reduce GIF Size 로고"
        width="36"
        height="36"
        class="w-9 h-9 rounded-xl shadow-md shadow-primary/25 transform group-hover:scale-105 transition-transform duration-200 object-contain"
      />
      <div class="flex flex-col">
        <span class="font-extrabold text-base sm:text-lg tracking-tight text-foreground leading-none">
          Reduce GIF <span class="text-primary">Size</span>
        </span>
        <span class="text-[10px] sm:text-[11px] font-semibold text-muted-foreground tracking-tight">
          GIF 용량 줄이기 & 크기 조절
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-5 text-xs font-semibold text-muted-foreground">
      <a href="/#tool-workspace" class="hover:text-primary transition">리사이저 툴</a>
      <a href="/#presets-table" class="hover:text-primary transition">플랫폼 규격</a>
      <a href="/#guide" class="hover:text-primary transition">최적화 가이드</a>
      <a href="/#faq" class="hover:text-primary transition">자주 묻는 질문</a>
      <a href="/about" class="hover:text-primary transition">소개</a>
      <a href="/contact" class="hover:text-primary transition">문의</a>
    </nav>

    <!-- Controls: Language, Theme Palette, Dark Mode -->
    <div class="flex items-center gap-2 sm:gap-3">
      
      <!-- Bilingual Language Selector (Korean Primary, English Secondary) -->
      <div class="inline-flex rounded-xl border border-border p-0.5 bg-muted/40 text-xs font-bold font-mono">
        <button
          id="btn-lang-ko"
          type="button"
          class="px-2.5 py-1 rounded-lg bg-card text-foreground shadow-xs transition"
          aria-label="한국어로 전환"
        >
          KO
        </button>
        <button
          id="btn-lang-en"
          type="button"
          class="px-2.5 py-1 rounded-lg text-muted-foreground hover:text-foreground transition"
          aria-label="Switch to English"
        >
          EN
        </button>
      </div>

      <!-- 4 Themes Dropdown/Selector -->
      <div class="relative group">
        <button
          id="theme-dropdown-btn"
          type="button"
          class="p-2 rounded-xl border border-border bg-card hover:bg-muted/50 text-muted-foreground hover:text-foreground transition flex items-center gap-1.5 text-xs font-medium"
          title="테마 색상 변경"
          aria-label="테마 색상 변경"
        >
          <span class="w-3.5 h-3.5 rounded-full bg-primary inline-block"></span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div class="absolute right-0 mt-2 w-44 rounded-2xl border border-border bg-card p-1.5 shadow-xl hidden group-hover:block hover:block z-50 animate-in fade-in zoom-in-95 duration-150">
          <div class="text-[10px] font-bold text-muted-foreground px-2 py-1 uppercase tracking-wider">
            컬러 테마 (OKLCH)
          </div>
          <button
            data-theme="default"
            class="w-full px-2.5 py-2 rounded-xl text-left text-xs font-medium hover:bg-muted/40 flex items-center gap-2 text-foreground transition"
          >
            <span class="w-3 h-3 rounded-full bg-indigo-600"></span>
            <span>일렉트릭 인디고</span>
          </button>
          <button
            data-theme="theme-emerald"
            class="w-full px-2.5 py-2 rounded-xl text-left text-xs font-medium hover:bg-muted/40 flex items-center gap-2 text-foreground transition"
          >
            <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
            <span>에메랄드 민트</span>
          </button>
          <button
            data-theme="theme-amber"
            class="w-full px-2.5 py-2 rounded-xl text-left text-xs font-medium hover:bg-muted/40 flex items-center gap-2 text-foreground transition"
          >
            <span class="w-3 h-3 rounded-full bg-amber-500"></span>
            <span>사프란 앰버</span>
          </button>
          <button
            data-theme="theme-purple"
            class="w-full px-2.5 py-2 rounded-xl text-left text-xs font-medium hover:bg-muted/40 flex items-center gap-2 text-foreground transition"
          >
            <span class="w-3 h-3 rounded-full bg-purple-600"></span>
            <span>로열 바이올렛</span>
          </button>
        </div>
      </div>

      <!-- Dark / Light Mode Toggle -->
      <button
        id="theme-toggle-btn"
        type="button"
        class="p-2 rounded-xl border border-border bg-card hover:bg-muted/50 text-muted-foreground hover:text-foreground transition"
        aria-label="다크 모드 토글"
        title="다크 모드 / 라이트 모드"
      >
        <!-- Sun icon (for dark mode) -->
        <svg id="theme-icon-sun" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon icon (for light mode) -->
        <svg id="theme-icon-moon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Mobile Menu Button (Hamburger) -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden p-2 rounded-xl border border-border bg-card hover:bg-muted/50 text-foreground transition focus:outline-none focus:ring-2 focus:ring-primary/40"
        aria-label="모바일 메뉴 열기"
        aria-expanded="false"
      >
        <svg id="hamburger-icon" class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-4.5 h-4.5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

    </div>

  </div>

  <!-- Mobile Navigation Dropdown Drawer -->
  <div
    id="mobile-menu-drawer"
    class="lg:hidden hidden border-t border-border bg-card/95 backdrop-blur-xl px-4 py-4 space-y-2 transition-all duration-200"
  >
    <nav class="flex flex-col space-y-1 text-sm font-semibold">
      <a href="/#tool-workspace" class="mobile-nav-link flex items-center justify-between px-3.5 py-2.5 rounded-xl hover:bg-muted/50 text-foreground transition">
        <span>리사이저 툴</span>
        <span class="text-xs text-primary font-mono font-bold">Tool</span>
      </a>
      <a href="/#presets-table" class="mobile-nav-link flex items-center justify-between px-3.5 py-2.5 rounded-xl hover:bg-muted/50 text-muted-foreground hover:text-foreground transition">
        <span>플랫폼 규격</span>
        <span class="text-xs text-muted-foreground font-mono">Specs</span>
      </a>
      <a href="/#guide" class="mobile-nav-link flex items-center justify-between px-3.5 py-2.5 rounded-xl hover:bg-muted/50 text-muted-foreground hover:text-foreground transition">
        <span>최적화 가이드</span>
        <span class="text-xs text-muted-foreground font-mono">Guide</span>
      </a>
      <a href="/#faq" class="mobile-nav-link flex items-center justify-between px-3.5 py-2.5 rounded-xl hover:bg-muted/50 text-muted-foreground hover:text-foreground transition">
        <span>자주 묻는 질문</span>
        <span class="text-xs text-muted-foreground font-mono">FAQ</span>
      </a>
      <div class="h-px bg-border/60 my-1.5"></div>
      <a href="/about" class="mobile-nav-link flex items-center justify-between px-3.5 py-2.5 rounded-xl hover:bg-muted/50 text-muted-foreground hover:text-foreground transition">
        <span>서비스 소개</span>
        <span class="text-xs text-muted-foreground">About</span>
      </a>
      <a href="/contact" class="mobile-nav-link flex items-center justify-between px-3.5 py-2.5 rounded-xl hover:bg-muted/50 text-muted-foreground hover:text-foreground transition">
        <span>문의하기</span>
        <span class="text-xs text-muted-foreground">Contact</span>
      </a>
    </nav>
  </div>
</header>

<script is:inline>
  // Mobile Hamburger Menu Toggle
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenuDrawer = document.getElementById('mobile-menu-drawer');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  function toggleMobileMenu(forceClose = false) {
    if (!mobileMenuDrawer) return;
    const isCurrentlyOpen = !mobileMenuDrawer.classList.contains('hidden');
    const shouldOpen = forceClose ? false : !isCurrentlyOpen;

    if (shouldOpen) {
      mobileMenuDrawer.classList.remove('hidden');
      hamburgerIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      mobileMenuBtn?.setAttribute('aria-expanded', 'true');
    } else {
      mobileMenuDrawer.classList.add('hidden');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      mobileMenuBtn?.setAttribute('aria-expanded', 'false');
    }
  }

  mobileMenuBtn?.addEventListener('click', () => toggleMobileMenu());

  // Close drawer when any mobile nav link is clicked
  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => toggleMobileMenu(true));
  });
  // Dark mode handler
  const htmlEl = document.documentElement;
  const toggleBtn = document.getElementById('theme-toggle-btn');
  const sunIcon = document.getElementById('theme-icon-sun');
  const moonIcon = document.getElementById('theme-icon-moon');

  const savedTheme = localStorage.getItem('app-dark-mode');
  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

  if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
    htmlEl.classList.add('dark');
    sunIcon?.classList.remove('hidden');
    moonIcon?.classList.add('hidden');
  } else {
    htmlEl.classList.remove('dark');
    sunIcon?.classList.add('hidden');
    moonIcon?.classList.remove('hidden');
  }

  toggleBtn?.addEventListener('click', () => {
    const isDark = htmlEl.classList.toggle('dark');
    localStorage.setItem('app-dark-mode', isDark ? 'dark' : 'light');
    if (isDark) {
      sunIcon?.classList.remove('hidden');
      moonIcon?.classList.add('hidden');
    } else {
      sunIcon?.classList.add('hidden');
      moonIcon?.classList.remove('hidden');
    }
  });

  // Color theme preset handler (Indigo, Emerald, Amber, Purple)
  const savedColorTheme = localStorage.getItem('app-color-theme') || 'default';
  if (savedColorTheme && savedColorTheme !== 'default') {
    htmlEl.classList.add(savedColorTheme);
  }

  document.querySelectorAll('[data-theme]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const theme = e.currentTarget.getAttribute('data-theme');
      htmlEl.classList.remove('theme-emerald', 'theme-amber', 'theme-purple');
      if (theme && theme !== 'default') {
        htmlEl.classList.add(theme);
        localStorage.setItem('app-color-theme', theme);
      } else {
        localStorage.setItem('app-color-theme', 'default');
      }
    });
  });

  // Bilingual switcher handler
  const btnKo = document.getElementById('btn-lang-ko');
  const btnEn = document.getElementById('btn-lang-en');

  function setLanguage(lang) {
    localStorage.setItem('app-lang', lang);
    if (lang === 'ko') {
      btnKo?.classList.add('bg-card', 'text-foreground', 'shadow-xs');
      btnKo?.classList.remove('text-muted-foreground');
      btnEn?.classList.remove('bg-card', 'text-foreground', 'shadow-xs');
      btnEn?.classList.add('text-muted-foreground');
      htmlEl.setAttribute('lang', 'ko-KR');
    } else {
      btnEn?.classList.add('bg-card', 'text-foreground', 'shadow-xs');
      btnEn?.classList.remove('text-muted-foreground');
      btnKo?.classList.remove('bg-card', 'text-foreground', 'shadow-xs');
      btnKo?.classList.add('text-muted-foreground');
      htmlEl.setAttribute('lang', 'en');
    }
    window.dispatchEvent(new CustomEvent('app:lang-change', { detail: lang }));
  }

  const savedLang = localStorage.getItem('app-lang') || 'ko';
  setLanguage(savedLang);

  btnKo?.addEventListener('click', () => setLanguage('ko'));
  btnEn?.addEventListener('click', () => setLanguage('en'));
</script>
