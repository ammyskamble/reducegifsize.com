---
// src/components/FaqSection.astro
import { KOREAN_FAQS, ENGLISH_FAQS } from '../data/faqs';
---

<section id="faq" class="w-full max-w-5xl mx-auto py-16 px-4 sm:px-6 lg:px-8 space-y-12">
  
  <!-- Header -->
  <div class="text-center space-y-3 max-w-2xl mx-auto">
    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-primary/10 border border-primary/25 text-primary text-xs font-semibold">
      <span>SEO Friendly FAQ</span>
    </div>
    <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-foreground">
      자주 묻는 질문 (FAQ) & 기술 가이드
    </h2>
    <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed">
      GIF 용량 줄이기, 프로그램별(포토샵/프리미어) 압축 노하우, 플랫폼별 용량 제한에 관한 질문들을 상세히 정리했습니다.
    </p>
  </div>

  <!-- Category 1: Korean In-Depth FAQ -->
  <div class="space-y-4">
    <div class="flex items-center gap-2 px-1">
      <span class="w-2 h-2 rounded-full bg-primary"></span>
      <h3 class="text-base sm:text-lg font-bold text-foreground">
        한국어 가이드: 용량 압축, 프로그램 연동 및 플랫폼 규격
      </h3>
    </div>

    <div class="space-y-3">
      {KOREAN_FAQS.map((faq) => (
        <details class="group rounded-2xl border border-border bg-card p-4 sm:p-5 shadow-sm transition-all duration-200 open:shadow-md">
          <summary class="flex items-center justify-between font-bold text-sm sm:text-base text-foreground cursor-pointer select-none list-none">
            <span class="flex items-center gap-2.5">
              <span class="w-6 h-6 rounded-lg bg-primary/10 text-primary flex items-center justify-center text-xs font-mono font-bold shrink-0">
                Q
              </span>
              <span class="text-left">{faq.question}</span>
            </span>
            <div class="flex items-center gap-2 shrink-0 ml-2">
              <span class="hidden sm:inline-block px-2 py-0.5 rounded-md bg-muted/40 border border-border text-[10px] text-muted-foreground font-medium">
                {faq.category}
              </span>
              <svg class="w-4 h-4 text-muted-foreground group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </summary>
          <div class="mt-3.5 pt-3.5 border-t border-border/60 text-xs sm:text-sm text-muted-foreground leading-relaxed pl-8">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>
  </div>

  <!-- Category 2: Global English FAQ -->
  <div class="space-y-4 pt-4 border-t border-border">
    <div class="flex items-center gap-2 px-1">
      <span class="w-2 h-2 rounded-full bg-cyan-glow"></span>
      <h3 class="text-base sm:text-lg font-bold text-foreground">
        Global Frequently Asked Questions (English)
      </h3>
    </div>

    <div class="space-y-3">
      {ENGLISH_FAQS.map((faq) => (
        <details class="group rounded-2xl border border-border bg-card p-4 sm:p-5 shadow-sm transition-all duration-200 open:shadow-md">
          <summary class="flex items-center justify-between font-bold text-sm sm:text-base text-foreground cursor-pointer select-none list-none">
            <span class="flex items-center gap-2.5">
              <span class="w-6 h-6 rounded-lg bg-cyan-glow/15 text-cyan-glow flex items-center justify-center text-xs font-mono font-bold shrink-0">
                Q
              </span>
              <span class="text-left">{faq.question}</span>
            </span>
            <div class="flex items-center gap-2 shrink-0 ml-2">
              <span class="hidden sm:inline-block px-2 py-0.5 rounded-md bg-muted/40 border border-border text-[10px] text-muted-foreground font-medium">
                {faq.category}
              </span>
              <svg class="w-4 h-4 text-muted-foreground group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </summary>
          <div class="mt-3.5 pt-3.5 border-t border-border/60 text-xs sm:text-sm text-muted-foreground leading-relaxed pl-8">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>
  </div>

</section>
